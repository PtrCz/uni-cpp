HeaderFilterRegex: 'test/src/.*\.hpp$|include/uni-cpp/.*\.hpp$'
Checks: '-*,readability-identifier-naming,bugprone-*,-bugprone-throwing-static-initialization,clang-analyzer-*,performance-*,-clang-analyzer-optin.core.EnumCastOutOfRange,-performance-unnecessary-value-param'

# -clang-analyzer-optin.core.EnumCastOutOfRange is to avoid warnings from Catch2 macro expansions
# -performance-unnecessary-value-param is to prevent clang-tidy from crashing on template-heavy code

CheckOptions:
  - key: readability-identifier-naming.DefaultCase
    value: lower_case
  - key: readability-identifier-naming.PrivateMemberPrefix
    value: m_
  - key: readability-identifier-naming.MacroDefinitionCase
    value: UPPER_CASE
  - key: readability-identifier-naming.TemplateParameterCase
    value: CamelCase